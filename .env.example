# Copy to .env at the repo root and fill in your real password.
# .env is gitignored and must never be committed.

# Local PostgreSQL 17, created in Phase 1.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/dental_clinic"

# API port. The Vite dev proxy in client/vite.config.ts targets this.
PORT=3000

# IANA timezone of the fictional clinic. Explicit on purpose — never inherited
# from the server locale. See docs/database-design.md.
CLINIC_TIMEZONE="America/New_York"

# Signs session cookies. At least 32 characters — generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Leaving this unset does not fail loudly on its own: Better Auth generates one,
# and every restart then invalidates every session. env.ts rejects it instead.
BETTER_AUTH_SECRET="generate_your_own_do_not_use_this_value"

# Where the API itself is reachable, and where the browser loads the client from.
BETTER_AUTH_URL="http://localhost:3000"
CLIENT_ORIGIN="http://localhost:5173"
